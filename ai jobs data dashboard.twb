      <column caption='remote_work_type' datatype='string' name='[Calculation_3979493258623619072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [remote_ratio] = 100 THEN &quot;Remote&quot;&#13;&#10;ELSEIF [remote_ratio] = 0 THEN &quot;Onsite&quot;&#13;&#10;ELSE &quot;Hybrid&quot;&#13;&#10;END' />
      </column>
      <column caption='salary_category' datatype='string' name='[Calculation_3979493258623803393]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [salary_usd] &lt; 100000 THEN &quot;Medium (50K-100K)&quot;&#13;&#10;ELSEIF [salary_usd] &gt;= 100000 AND [salary_usd] &lt;= 150000 THEN &quot;High (100K-150K)&quot;&#13;&#10;ELSE &quot;Very High (150K+)&quot;&#13;&#10;END' />
      </column>
